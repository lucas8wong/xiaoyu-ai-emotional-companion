@@ -0,0 +1,74 @@
+import type {EvidencePart} from './memoryExtraction.js';
+import type {ExtractedMemoryFact} from '../../src/lib/memoryEvidence.js';
+
+export const handoffFields=['scene','nextStep','mustRemember'] as const;
+export type HandoffField=typeof handoffFields[number];
+export interface HandoffCheck {field:HandoffField;text:string;complete:boolean;claims:Array<{text:string;sources:string[];supported:boolean}>}
+export interface HandoffManualSource {id:string;text:string;updatedAt?:number}
+export interface StoryHandoffEvidence {version:1;through:number;checks:HandoffCheck[];unverifiedFields?:HandoffField[];knownSources?:Array<Pick<ExtractedMemoryFact,'id'|'evidence'>>;manualSources?:HandoffManualSource[]}
+/** Only enabled, server-owned manual cards from this invocation's owner/run.
+ * A card is correction authority, not evidence that an actor arrived or acted. */
+export function handoffManualSources(corrections:unknown):HandoffManualSource[]{
+ if(!Array.isArray(corrections))return [];
+ const counts=new Map<string,number>();for(const c of corrections)if(typeof c?.id==='string')counts.set(c.id,(counts.get(c.id)||0)+1);
+ return corrections.filter(c=>c?.kind==='manual'&&c.enabled===true&&c.deleted!==true&&typeof c.id==='string'&&/^manual:[\w-]+$/.test(c.id)&&counts.get(c.id)===1&&typeof c.text==='string'&&!!c.text.trim())
+  .map(c=>({id:c.id,text:c.text,...(Number.isFinite(c.updatedAt)?{updatedAt:c.updatedAt}:{})}));
+}
+export const handoffManualSourceContract=' eligibleManualSourceIds identify the current enabled user-authored memory/correction cards for THIS story/run; read each card text from corrections with that exact ID. In handoffChecks.sources for mustRemember ONLY, the source enum additionally permits these exact manual: IDs when their card text directly supports that remembered condition, identity or explicit user correction; preserve its attribution and uncertainty. Never use a manual card to establish a chapter event, current physical presence/location/time, or a pending nextStep. Scene and nextStep still require their original evidence rules. Disabled/deleted cards and arbitrary IDs are not sources. Do not invent a paragraph citation when the actual authority is an eligible manual card.';
+export const HANDOFF_AUDIT_FLAGS=['handoff_fields_missing','handoff_checks_invalid','handoff_field_invalid','handoff_text_mismatch','handoff_incomplete','handoff_claims_invalid','handoff_claim_unsupported','handoff_source_invalid','handoff_manual_source_forbidden','handoff_unsourced_claim','handoff_coverage_mismatch'] as const;
+export type HandoffAuditFlag=typeof HANDOFF_AUDIT_FLAGS[number];
+/** Binding checks establish provenance, not semantic entailment. The independent
+ * auditor must additionally verify each predicate against the complete chapter. */
+export const handoffAuditContract=' Additionally return handoffChecks: [{field:"scene|nextStep|mustRemember",text:"EXACT supplied field text",complete:boolean,claims:[{text:"one literal contiguous portion of that field",sources:["original evidence id"],supported:boolean}]}], exactly once per field. Split EVERY person/presence, actor location, object location, time, action and commitment into separately checked claims; concatenate claim text in order to reproduce the field exactly (whitespace/punctuation may differ). Check the WHOLE predicate, not matching names. Identity, occupation, mention, a phone/letter conversation, recollection or a place containing an object NEVER establish physical presence or an actor location. Plans/destinations are not arrivals; apply later departures, moves, corrections and completions through the chapter end. All scenes are as of this chapter, not a later current scene. Scene claims may cite only current chapter original evidence IDs, never previousState, known fact IDs or unsourced names as proof. mustRemember may additionally cite an exact eligibleKnownFacts ID for an unchanged historical fact. nextStep may cite such an ID only for a still-active plan. Never cite a replaced fact or infer a new scene/action from a historical identity or object. Claims with no supporting evidence must be supported:false. A literal unknown/none statement may use sources:[] only when genuinely unknown; use ONLY these exact unsourced forms: 未明确, 地点未明确, 时间未明确, 在场人未明确, 无明确待办, unknown, place unknown, time unknown, participants unknown, no established pending action. Do not expand them with explanatory prose; complete:false if this omits an explicit known fact. Scene place, time and participants can be independently unknown. Return bodySupported, bodyComplete, factsSupported and factsComplete booleans for the narrative excluding the three handoff lines and for the ledger, respectively. Whole supported/complete must reflect ALL checks, including handoff. proposed.narrativeBody is explicitly the body WITHOUT handoff: an error occurring only in handoff must NOT set bodySupported/bodyComplete or factsSupported/factsComplete false. These separate booleans decide whether a bounded field-only repair is safe. Do not silently repair text during auditing.';
+export const handoffGenerationContract=' Keep scene, nextStep and mustRemember as individually evidence-grounded clauses. Mention/identity/occupation does not establish presence; an object location does not locate an actor; phone calls, recollections and planned destinations do not establish arrival. Track final departures/corrections. Do not carry a later previousState backwards into this chapter. Separate independently known and unknown scene components. For unknown components use ONLY exact phrases 地点未明确, 时间未明确, 在场人未明确, 未明确 (English: place unknown, time unknown, participants unknown, unknown); do not append an explanation to unknown phrases. For no pending action use exactly 无明确待办 / no established pending action only if no pending action is evidenced.';
+export function handoffValues(text:string):Record<HandoffField,string>|null{
+ const lines=text.trim().split(/\r?\n/).map(s=>s.trim()).filter(Boolean).slice(-3);
+ const patterns=[/^(?:【接[续續]】(?:场景|場景)|\[Next\] Scene)[：:]\s*(.+)$/i,/^(?:【接[续續]】下一步|\[Next\] Next step)[：:]\s*(.+)$/i,/^(?:【接[续續]】(?:务必记住|務必記住)|\[Next\] Must remember)[：:]\s*(.+)$/i];
+ const values=patterns.map((p,i)=>lines[i]?.match(p)?.[1]);
+ return values.every(Boolean)?Object.fromEntries(handoffFields.map((f,i)=>[f,values[i]!])) as Record<HandoffField,string>:null;
+}
+const normalize=(s:string)=>s.replace(/[\s\p{P}]/gu,'');
+const unknown=(s:string)=>/^(?:(?:地点|地點|时间|時間|在场人|在場人|场景|場景)?(?:未知|未明确|未明確)|(?:place|time|participants)?unknown|未知|未明确|未明確|无|無|无明确待办|無明確待辦|无明确记录|無明確記錄|unknown|none|notestablished|noestablishedpendingaction)$/i.test(normalize(s));
+export function inspectHandoffAudit(value:unknown,text:string,parts:readonly EvidencePart[],through:number,known:readonly ExtractedMemoryFact[]=[],corrections:unknown=[]){
+ const fields=handoffValues(text);
+ const input=(value as {handoffChecks?:unknown})?.handoffChecks;
+ const rows=Array.isArray(input)?input:[];
+ const flags:HandoffAuditFlag[]=[];
+ const checks:HandoffCheck[]=[];
+ const invalid:HandoffField[]=[];
+ const ids=new Set(parts.map(p=>p.id));
+ const manualById=new Map(handoffManualSources(corrections).map(c=>[c.id,c]));
+ const knownById=new Map(known.filter(f=>f.kind!=='profile'&&f.evidence.length&&f.evidence.every(e=>e.quote&&Number.isInteger(e.message)&&Number.isInteger(e.offset))).map(f=>[f.id,f]));
+ if(rows.length!==3||rows.some(r=>!handoffFields.includes(r?.field)))flags.push('handoff_checks_invalid');
+ function validate(field:HandoffField):HandoffAuditFlag|undefined {
+   if(!fields)return 'handoff_fields_missing';
+   const matches=rows.filter(r=>r?.field===field);
+   if(matches.length!==1)return 'handoff_field_invalid';
+   const row=matches[0];
+   if(row.text!==fields[field])return 'handoff_text_mismatch';
+   if(row.complete!==true)return 'handoff_incomplete';
+   if(!Array.isArray(row.claims)||!row.claims.length)return 'handoff_claims_invalid';
+   for(const c of row.claims){
+     if(!c||typeof c.text!=='string'||!normalize(c.text)||!Array.isArray(c.sources))return 'handoff_claims_invalid';
+     if(c.supported!==true)return 'handoff_claim_unsupported';
+     if(field!=='mustRemember'&&c.sources.some((id:string)=>manualById.has(id)))return 'handoff_manual_source_forbidden';
+     const allowed=(id:string)=>ids.has(id)||field==='mustRemember'&&(manualById.has(id)||knownById.has(id))||field==='nextStep'&&knownById.get(id)?.kind==='plan';
+     if(c.sources.some((id:string)=>!allowed(id))||new Set(c.sources).size!==c.sources.length)return 'handoff_source_invalid';
+     if(!c.sources.length&&!unknown(c.text))return 'handoff_unsourced_claim';
+   }
+   if(normalize(row.claims.map((c:HandoffCheck['claims'][number])=>c.text).join(''))!==normalize(row.text))return 'handoff_coverage_mismatch';
+   checks.push({field,text:row.text,complete:true,claims:row.claims.map((c:HandoffCheck['claims'][number])=>({text:c.text,sources:[...c.sources],supported:true}))});
+ }
+ for(const field of handoffFields){
+   const flag=validate(field);
+   if(flag){invalid.push(field);if(!flags.includes(flag))flags.push(flag);}
+ }
+ const cited=new Set(checks.flatMap(row=>row.claims.flatMap(c=>c.sources)));
+ const knownSources=[...cited].filter(id=>knownById.has(id)).map(id=>({id,evidence:structuredClone(knownById.get(id)!.evidence)}));
+ const manualSources=[...cited].filter(id=>manualById.has(id)).map(id=>({...manualById.get(id)!}));
+ const partial:StoryHandoffEvidence={version:1,through,checks,...(knownSources.length?{knownSources}:{}),...(manualSources.length?{manualSources}:{})};
+ return {evidence:flags.length?null:partial,partial,invalid,flags};
+}
+export function validateHandoffAudit(value:unknown,text:string,parts:readonly EvidencePart[],through:number,known:readonly ExtractedMemoryFact[]=[],corrections:unknown=[]):StoryHandoffEvidence|null{
+ return inspectHandoffAudit(value,text,parts,through,known,corrections).evidence;
+}
