+  assert.ok(summary.facts?.[0].evidence[0].quote.includes('岚舟'));
+  assert.equal(summary.facts?.[0].evidence[0].message,10);
+  for(const request of requests){const audit=request.callKind==='story-memory-audit';const recap=request.callKind==='story-ledger-recap';
+    if(audit){assert.equal(request.maxTokens,16384);assert.equal(request.maxTokensCap,16384);}
