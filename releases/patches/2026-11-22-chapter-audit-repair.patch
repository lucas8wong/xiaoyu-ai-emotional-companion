+/** Synthetic positive auditor for transport/lifecycle tests, not a semantic oracle. */
+export function handoffAuditFixture(input:any,verdict:any={supported:true,complete:true,issues:[]}){
+ if(!input?.proposed?.handoff)return verdict;
+ return {bodySupported:verdict.supported,bodyComplete:verdict.complete,factsComplete:verdict.complete,factsSupported:verdict.supported,...verdict,handoffChecks:Object.entries(input.proposed.handoff).map(([field,text])=>({field,text,complete:true,claims:[{text,supported:true,sources:input.evidence?.[0]?[input.evidence[0].id]:[]}]}))};
+}
