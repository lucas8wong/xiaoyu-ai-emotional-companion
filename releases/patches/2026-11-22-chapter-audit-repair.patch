+import type {ExtractedMemoryFact} from '../../src/lib/memoryEvidence.js';
+import {parseExtractedFacts,type EvidencePart} from './memoryExtraction.js';
+import {isFallbackBubble} from '../../src/lib/fallbackBubbles.js';
+import {handoffValues} from './storyHandoffEvidence.js';
+
+type Row={turn:number;facts:ExtractedMemoryFact[]};
+type Part=EvidencePart&{turn:number};
+export const chapterEditContract='For each consequential rejected BODY or FACT predicate return edits:[{target:"body|facts",before:"verbatim unique wrong phrase or insertion anchor in narrativeBody, or exact fact.text",after:"corrected phrase, or anchor plus missing material",source:"exact current chapter evidence id",quote:"short verbatim passage from that id",factId:"existing fact id for fact update"}]. Fix only the erroneous predicate. Preserve unchanged text including the anchor for an insertion. For a missing fact use before:"", factId:"", subject, key, kind, after and the source/quote. For an unsupported existing fact use after:"" to delete it. Fact edits may include citations:[{source,quote}] for additional clauses. Return [] for supported components. Never use a walkthrough as an edit. Issue/review entries for players must identify the exact sentence, source ID and original quote.';
+
+export function applyChapterEdits(raw:unknown,text:string,ledger:Row[],parts:readonly Part[],scope:string,known:readonly ExtractedMemoryFact[],state:unknown,bodyFailed:boolean,factsFailed:boolean){
+ if(!Array.isArray(raw)||!raw.length)return null;
+ const passages=new Map(parts.map(p=>[p.id,p]));
+ const suffix=text.match(/(?:\r?\n[^\n]*){3}$/)?.[0];
+ if(!suffix||!handoffValues(text))return null;
+ const body=text.slice(0,-suffix.length);
+ const spans:{start:number;end:number;after:string}[]=[];
+ const rows=ledger.map(r=>({...r,facts:r.facts.slice()}));
+ const seen=new Set<string>();
+ let changedFacts=0;
+ const review:{kind:'mismatch'|'missing';target:string;summary:string;source:string;sourceId:string;note:string;what:string;fill:string}[]=[];
+ for(const edit of raw){
+   if(!edit||typeof edit.before!=='string'||typeof edit.after!=='string')return null;
+   // A comparison with no textual change authorizes no mutation.
+   if(edit.before===edit.after)continue;
+   if(typeof edit.quote!=='string'||!edit.quote.trim()||!passages.get(edit.source)?.text.includes(edit.quote)||isFallbackBubble(edit.after))return null;
+   if(edit.target==='body'&&bodyFailed){
+     if(!edit.before.trim()||/\n\s*\n/.test(edit.before)||edit.after.includes('\n【接')||edit.after.includes('\n[Next]'))return null;
+     const start=body.indexOf(edit.before);
+     if(start<0||body.indexOf(edit.before,start+1)>=0)return null;
+     spans.push({start,end:start+edit.before.length,after:edit.after});
+   }else if(edit.target==='facts'&&factsFailed){
+     const existing=ledger.flatMap(r=>r.facts).find(f=>f.id===edit.factId);
+     if(edit.factId?!existing||existing.text!==edit.before||seen.has(existing.id):edit.before!==''||!edit.after.trim())return null;
+     if(existing)seen.add(existing.id);
+     // Rewriting a depended-on fact changes its content-derived ID. Keep the
+     // entire draft pending rather than leave a silently broken replacement.
+     if(existing&&ledger.some(r=>r.facts.some(f=>f.replaces.includes(existing.id))))return null;
+     const originalRow=existing?rows.find(row=>row.facts.some(f=>f.id===existing.id)):undefined;
+     const index=originalRow?.facts.findIndex(f=>f.id===existing?.id)??-1;
+     if(existing&&(!originalRow||index<0))return null;
+     if(!edit.after.trim()){
+       if(!originalRow)return null;
+       originalRow.facts.splice(index,1);
+     }else{
+       const citations=[{source:edit.source,quote:edit.quote},...(Array.isArray(edit.citations)?edit.citations:[])];
+       if(citations.some(c=>!c||typeof c.quote!=='string'||!c.quote.trim()||!passages.get(c.source)?.text.includes(c.quote)))return null;
+       const turn=Math.max(...citations.map(c=>passages.get(c.source)!.turn));
+       const destination=rows.find(row=>row.turn===turn);
+       if(!destination)return null;
+       const prior=[...known,...rows.filter(row=>row.turn<turn).flatMap(row=>row.facts).filter(f=>f.id!==existing?.id)];
+       try{
+         const [fixed]=parseExtractedFacts([{...existing,kind:edit.kind??existing?.kind,subject:edit.subject??existing?.subject,key:edit.key??existing?.key,value:edit.after,text:edit.after,replaces:existing?.replaces??[],evidence:citations}],parts.filter(p=>p.turn<=turn),scope,prior,true,state);
+         if(rows.some(row=>row.facts.some(f=>f.id===fixed.id&&f.id!==existing?.id)))return null;
+         if(destination===originalRow)destination.facts.splice(index,1,fixed);
+         else{
+           originalRow?.facts.splice(index,1);
+           destination.facts.push(fixed);
+         }
+       }catch{return null;}
+     }
+     changedFacts++;
+   }else return null;
+   review.push({kind:edit.before?'mismatch':'missing',target:edit.target,summary:edit.before,source:edit.quote,sourceId:edit.source,note:'['+edit.source+'] '+(edit.before?edit.after:edit.quote),what:edit.before||edit.after,fill:edit.after});
+ }
+ if(bodyFailed&&!spans.length||factsFailed&&!changedFacts)return null;
+ let repaired=body,end=body.length;
+ for(const span of spans.sort((a,b)=>b.start-a.start)){
+   if(span.end>end)return null;
+   repaired=repaired.slice(0,span.start)+span.after+repaired.slice(span.end);end=span.start;
+ }
+ if(!repaired.trim()||isFallbackBubble(repaired)||/(?:^|\n)\s*(?:【接[续續]】|\[Next\])/i.test(repaired))return null;
+ return {text:repaired+suffix,ledger:rows,review};
+}
+
+/** Only send review entries tied to this draft and a literal passage to the adoption dialog. */
+export function groundedChapterReview(raw:unknown,text:string,facts:readonly ExtractedMemoryFact[],parts:readonly Part[]){
+ if(!Array.isArray(raw))return [];
+ return raw.flatMap(item=>{
+   if(!item||typeof item.source!=='string'||!item.source.trim())return [];
+   const matching=parts.filter(p=>(!item.sourceId||p.id===item.sourceId)&&p.text.includes(item.source));
+   if(matching.length!==1)return [];
+   const sourceId=matching[0].id;
+   if(item.kind==='mismatch'){
+     if(typeof item.summary!=='string'||!item.summary.trim()||!(text.includes(item.summary)||facts.some(f=>f.text.includes(item.summary))))return [];
+   }else if(item.kind!=='missing'||typeof item.what!=='string'||!item.what.trim()||typeof item.fill!=='string'||!item.fill.trim())return [];
+   return [{...item,sourceId,note:[typeof item.note==='string'?item.note:'','['+sourceId+'] '+item.source].filter(Boolean).join(' ')}];
+ });
+}
+
+/** A reviewer can cite the wrong chapter. Expose an explicitly disputed ledger
+ * entry and its own original source for inspection, never as an approved edit. */
+export function disputedFactReview(edits:unknown,facts:readonly ExtractedMemoryFact[],parts:readonly Part[],zh:boolean){
+ if(!Array.isArray(edits))return [];
+ return edits.flatMap(edit=>{
+   if(edit?.target!=='facts'||edit.before===edit.after)return [];
+   const fact=facts.find(f=>f.id===edit.factId&&f.text===edit.before);
+   if(!fact)return [];
+   return fact.evidence.flatMap(e=>{
+     const part=parts.find(p=>p.message===e.message&&p.role===e.role&&p.offset<=e.offset&&
+       Array.from(p.text).slice(e.offset-p.offset,e.offset-p.offset+Array.from(e.quote).length).join('')===e.quote);
+     if(!part||!e.quote.trim())return [];
+     const label=zh?'这是草稿引用的原句。审核建议的改法仍待核实。':'This is the draft’s original citation. The proposed correction still needs verification.';
+     return [{kind:'mismatch',target:'facts',summary:fact.text,source:e.quote,sourceId:part.id,note:'['+part.id+'] '+label}];
+   });
+ });
+}
