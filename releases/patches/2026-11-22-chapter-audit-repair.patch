+    client:{models:{generateContent:async(req:any)=>{requests.push(req);const input=JSON.parse(req.contents[1].parts[0].text);
+      if(input.proposed)return response(handoffAuditFixture(input));
+      if(input.ledger)return response({recap:'岚舟接过蓝色档案。\n【接续】场景：未知。\n【接续】下一步：无。\n【接续】务必记住：岚舟持有蓝色档案。'});
+      const source=input.evidence.find((e:any)=>e.text.includes('中间的岚舟'));
+      return response({turns:input.requiredTurns.map((turn:number)=>({turn,facts:source?.turn===turn?[{kind:'event',subject:'岚舟',key:'档案交接',value:'接过蓝色档案',text:'岚舟接过蓝色档案。',replaces:[],evidence:[{source:source.id}]}]:[]}))});
