diff --git a/test/unit/storyLedgerTransport.test.ts b/test/unit/storyLedgerTransport.test.ts
new file mode 100644
--- /dev/null
+++ b/test/unit/storyLedgerTransport.test.ts
@@ -0,0 +1,144 @@
+import test, {type TestContext} from 'node:test';
+import assert from 'node:assert/strict';
+import {setupTempCwd} from './setup.js';
+
+setupTempCwd();
+Object.assign(process.env,{
+  PERSISTENCE_PROVIDER:'file',DEEPSEEK_V41_ROUTE:'sta1n',
+  STA1N_API_KEY:'gateway-fixture',DEEPSEEK_API_KEY:'official-fixture',
+  STA1N_WELFARE_ENABLED:'1',STA1N_WELFARE_BASE_URL:'https://welfare.invalid/v1',
+  STA1N_WELFARE_API_KEY:'welfare-fixture',STA1N_WELFARE_MODEL:'test',
+});
+const {createDeepSeekClientFor}=await import('../../api/services/deepseek.js');
+const {withStoryOrganizationBilling}=await import('../../api/services/storyOrganizationContext.js');
+const {__resetProviderHealth}=await import('../../api/services/providerHealth.js');
+
+const chapterStages=['story-fact-ledger','story-ledger-recap','story-memory-audit'] as const;
+
+function runStage(t:TestContext,options:{
+  frame?:object;
+  cancel?:boolean;
+  organization?:boolean;
+  stage?:string;
+  holdFallback?:boolean;
+  expiredOfficialPricing?:boolean;
+}={}){
+  __resetProviderHealth();
+  const calls:{host:string;model:string}[]=[];
+  const cancel=new AbortController();
+  const realTimer=globalThis.setTimeout;
+  let totalDeadlines=0,deadlineExpired=false;
+  t.mock.method(globalThis,'setTimeout',(cb:any,ms:number,...args:any[])=>{
+    if(ms===240000){
+      totalDeadlines++;
+      return realTimer(()=>{deadlineExpired=true;cb(...args);},300);
+    }
+    // The official request has a longer local timeout. Only the shared logical
+    // deadline can end the held fallback first.
+    const delay=ms===180000?(options.holdFallback&&calls.length?1000:60):ms;
+    return realTimer(cb,delay,...args);
+  });
+  t.mock.method(globalThis,'fetch',async(url:string,init:RequestInit)=>{
+    const host=new URL(url).hostname;
+    if(options.expiredOfficialPricing&&host==='api-docs.deepseek.com')return new Response(null,{status:503});
+    const body=JSON.parse(String(init.body));
+    calls.push({host,model:body.model});
+    const signal=init.signal!;
+    if(host==='api.deepseek.com'){
+      if(options.holdFallback)return new Promise<Response>((_,reject)=>{
+        signal.addEventListener('abort',()=>reject(signal.reason),{once:true});
+      });
+      return Response.json({choices:[{message:{content:'{"turns":[]}'},finish_reason:'stop'}],usage:{prompt_tokens:10,completion_tokens:4}});
+    }
+    assert.equal(host,'sta1n.ai');
+    assert.equal(body.stream,true);
+    return new Response(new ReadableStream({start(controller){
+      if(options.frame)controller.enqueue(new TextEncoder().encode('data: '+JSON.stringify(options.frame)+'\n\n'));
+      signal.addEventListener('abort',()=>controller.error(signal.reason),{once:true});
+      if(options.cancel)queueMicrotask(()=>cancel.abort(new DOMException('Stopped by user','AbortError')));
+    }}));
+  });
+  const client=createDeepSeekClientFor('deepseek-flash',{timeoutMs:180000,maxRetries:0});
+  const stage=options.stage??'story-fact-ledger';
+  const owner='transport-fixture-'+stage;
+  const invoke=()=>client.models.generateContent({
+    userId:owner,feature:'memory',callKind:stage,jsonMode:true,signal:cancel.signal,
+    contents:[{role:'user',parts:[{text:'Synthetic evidence for a test chapter.'}]}],
+  });
+  return {calls,owner,deadlines:()=>totalDeadlines,deadlineExpired:()=>deadlineExpired,result:options.organization===false?invoke():withStoryOrganizationBilling(invoke)};
+}
+
+test('a ledger with an expired official catalog cannot send the fallback at the cheaper gateway tariff',async t=>{
+  const expired=Date.now()+7*3_600_000;
+  t.mock.method(Date,'now',()=>expired);
+  const run=runStage(t,{expiredOfficialPricing:true});
+  await assert.rejects(run.result,/AI_BUDGET_MODEL_UNPRICED/);
+  assert.deepEqual(run.calls.map(call=>call.host),['sta1n.ai']);
+});
+
+for(const stage of chapterStages)test(stage+' stalled before its first output switches to the official model once',async t=>{
+  const run=runStage(t,{stage});
+  const result=await run.result;
+  assert.equal(result.finishReason,'stop');
+  assert.deepEqual(run.calls,[{host:'sta1n.ai',model:'deepseek-v4.1-flash'},{host:'api.deepseek.com',model:'deepseek-flash'}]);
+  assert.equal(run.deadlines(),1);
+  const {usageCallStore}=await import('../../api/services/usageCalls.js');
+  const [entry]=usageCallStore.byUser(run.owner);
+  assert.equal(entry.provider,'DeepSeek');
+  assert.equal(entry.callKind,stage);
+  const rate=result.usage.model_pricing;
+  assert.equal(rate.model,'deepseek-flash');
+  assert.equal(rate.source,'test-fixture');
+  assert.deepEqual(entry.modelPricing,rate);
+  assert.equal(entry.costYuan,(10*rate.input+4*rate.output)/1e6);
+});
+
+for(const stage of chapterStages)test(stage+' fallback shares the original deadline and cannot start a third request',async t=>{
+  const run=runStage(t,{stage,holdFallback:true});
+  await assert.rejects(run.result);
+  assert.deepEqual(run.calls.map(call=>call.host),['sta1n.ai','api.deepseek.com']);
+  assert.equal(run.deadlines(),1);
+  assert.equal(run.deadlineExpired(),true);
+});
+
+for(const [name,options] of [
+  ['partial JSON',{frame:{choices:[{delta:{content:'{"turns":'}}]}}],
+  ['reasoning alone',{frame:{choices:[{delta:{reasoning_content:'thinking'}}]}}],
+  ['provider usage alone',{frame:{usage:{prompt_tokens:12,completion_tokens:0}}}],
+  ['a finish signal with no trailing DONE marker',{frame:{choices:[{delta:{},finish_reason:'stop'}]}}],
+  ['tool output',{frame:{choices:[{delta:{tool_calls:[{index:0,id:'call-1',function:{name:'read'}}]}}]}}],
+  ['user cancellation',{cancel:true}],
+  ['a non-organization caller',{organization:false}],
+] as const){
+  for(const stage of chapterStages)test(stage+' idle fallback skips '+name,async t=>{
+    const run=runStage(t,{stage,...options});
+    await assert.rejects(run.result);
+    assert.deepEqual(run.calls.map(call=>call.host),['sta1n.ai']);
+  });
+}
+
+test('a different operation cannot acquire chapter fallback by sharing its billing context',async t=>{
+  const run=runStage(t,{stage:'chat-verified-recap'});
+  await assert.rejects(run.result);
+  assert.deepEqual(run.calls.map(call=>call.host),['sta1n.ai']);
+});
+
+test('the welfare channel keeps its own output limit while its DeepSeek fallback receives the full chapter ceiling',async t=>{
+  const {organizationClient}=await import('../../api/services/storyOrganization.js');
+  const requests:{host:string;limit:number}[]=[];
+  t.mock.method(globalThis,'fetch',async(url:string,init:RequestInit)=>{
+    const host=new URL(url).hostname;
+    const body=JSON.parse(String(init.body));
+    requests.push({host,limit:body.max_tokens});
+    if(host==='welfare.invalid')return Response.json({error:{message:'fixture unavailable'}},{status:503});
+    assert.equal(host,'sta1n.ai');
+    const answer={choices:[{delta:{content:'{"recap":"test"}'},finish_reason:'stop'}],usage:{prompt_tokens:10,completion_tokens:4}};
+    return new Response('data: '+JSON.stringify(answer)+'\n\ndata: [DONE]\n\n');
+  });
+  const meter=organizationClient({id:'isolated-welfare',owner:'welfare-limit',scope:'scope',from:1,to:10,cap:20,billingMultiplier:1} as any);
+  const result=await meter.client.models.generateContent({
+    contents:[{role:'user',parts:[{text:'Synthetic chapter'}]}],callKind:'story-ledger-recap',maxTokens:393216,maxTokensCap:393216,
+  });
+  assert.equal(result.finishReason,'stop');
+  assert.deepEqual(requests,[{host:'welfare.invalid',limit:16384},{host:'sta1n.ai',limit:393216}]);
+});
