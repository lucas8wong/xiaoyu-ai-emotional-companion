{
  "name": "xiaoyu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "test": "tsx --test --test-concurrency=1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:wenyou": "vitest run --config vitest.config.ts",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "build:prod": "tsx scripts/gen-sitemap.mts && vite build",
    "build:seo": "tsx scripts/gen-sitemap.mts && vite build && tsx scripts/prerender.mts",
    "sitemap": "tsx scripts/gen-sitemap.mts",
    "prerender": "tsx scripts/prerender.mts",
    "start:prod": "set NODE_ENV=production&& tsx api/server.ts",
    "check:all": "tsc --noEmit",
    "verify": "npm run check && npm run lint"
  },
